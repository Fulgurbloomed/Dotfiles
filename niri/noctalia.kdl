layout {

    focus-ring {
        active-color   "#e66766"
        inactive-color "#291414"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#e66766"
        inactive-color "#291414"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#e66766"
        inactive-color "#871312"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#e6676680"
    }
}

recent-windows {
    highlight {
        active-color "#e66766"
        urgent-color "#fd4663"
    }
}
